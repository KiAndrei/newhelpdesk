# Set these as ENVIRONMENT VARIABLES in your hosting dashboard (Render/Railway/Fly).
# Do NOT commit real values.
APP_NAME="Helpdesk API"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH__php_artisan_key:generate_--show
APP_DEBUG=false
APP_URL=https://your-backend.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=error

# PostgreSQL (managed). Easiest: paste the provider's connection string into DB_URL
DB_CONNECTION=pgsql
DB_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_SSLMODE=require

# --- or MySQL (e.g. Aiven/PlanetScale-compatible) ---
# DB_CONNECTION=mysql
# DB_URL=mysql://USER:PASSWORD@HOST:PORT/DBNAME
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

CACHE_STORE=file

# Your deployed frontend origin(s), exactly as shown in the browser (no trailing slash)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
