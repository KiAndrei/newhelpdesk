APP_NAME="Helpdesk API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Local database: SQLite (file: database/database.sqlite) ----
DB_CONNECTION=sqlite

# ---- Or local MySQL ----
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=helpdesk
# DB_USERNAME=root
# DB_PASSWORD=

CACHE_STORE=file

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
